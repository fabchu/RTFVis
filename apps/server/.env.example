# DATA_SOURCE: apps-script (live Google Sheet) oder csv (Offline-Fallback)
DATA_SOURCE=apps-script

# --- DATA_SOURCE=apps-script ---
APPS_SCRIPT_URL=
APPS_SCRIPT_TOKEN=

# --- DATA_SOURCE=csv ---
# ROSTER_CSV_PATH=./data/roster.csv
# SCANS_CSV_PATH=./data/scans.csv
# SHEET_TIMEZONE=Europe/Berlin

POLL_INTERVAL_MS=30000
DB_PATH=./data/rtfvis.db
HTTP_PORT=3001

# HOST: an wen der Server lauscht. Default 127.0.0.1 (nur vom eigenen Rechner erreichbar,
# lokaler Renntag-Betrieb). Für Hosting (z.B. Render) auf 0.0.0.0 setzen.
# HOST=127.0.0.1

# BASIC_AUTH_USER / BASIC_AUTH_PASS: beide setzen, um die komplette App (außer /health)
# hinter ein gemeinsames Passwort für eine kleine Gruppe zu legen. Leer lassen für offenen
# Zugriff (z.B. lokal). Müssen entweder beide gesetzt sein oder beide leer bleiben.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASS=
